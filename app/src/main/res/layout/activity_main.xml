<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top: Logo area (hidden when image loaded) -->
        <LinearLayout
            android:id="@+id/logoArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="200dp"
                android:layout_height="66dp"
                android:src="@drawable/watermark_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo" />

            <TextView
                android:id="@+id/tvLogoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textColor="@color/md_theme_onSurface"
                android:textAppearance="@style/TextAppearance.MotoWatermark.Headline" />
        </LinearLayout>

        <!-- Center hint (hidden when image loaded) -->
        <TextView
            android:id="@+id/tvCenterHint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/center_hint"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:visibility="visible" />

        <!-- Image Preview in MaterialCardView (shown when image loaded) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/md_theme_surfaceVariant"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- FABs - between preview and control panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="12dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Camera"
                app:fabSize="normal"
                app:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="@string/select_photo"
                app:fabSize="normal"
                app:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="Rotate"
                android:visibility="gone"
                app:fabSize="normal"
                app:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="@string/save_image"
                android:visibility="gone"
                app:fabSize="normal"
                app:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Bottom Control Panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Section: Style -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_style"
                    android:textAppearance="@style/TextAppearance.MotoWatermark.Label"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/styleChipGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:singleSelection="true"
                        app:chipSpacingHorizontal="3dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle1"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_standard"
                            android:textSize="13sp"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle3"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_corner"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle4"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_classic"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle10"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_transp"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle11"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_f1"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStyle12"
                            style="@style/Widget.MotoWatermark.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/style_pure"
                            android:textSize="13sp" />
                    </com.google.android.material.chip.ChipGroup>

                    <ImageView
                        android:id="@+id/ivStylePreview"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Style preview" />
                </LinearLayout>

                <!-- Pick color chip (added dynamically) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/colorChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="6dp"
                    android:layout_marginTop="6dp" />

                <!-- Section: Owner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/owner"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        app:hintTextColor="@color/md_theme_onSurfaceVariant"
                        app:boxStrokeColor="@color/md_theme_outline"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusBottomEnd="28dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOwnerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_owner"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:inputType="textPersonName|textNoSuggestions"
                            android:textColor="@color/md_theme_onSurface" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Section: Device model (v1.1.7 manual select) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_model_label"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeviceModel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:text="@string/device_auto"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:cornerRadius="28dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_outlineVariant"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="3dp" />

                <!-- Section: Toggles - clean 2-column grid -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_toggles"
                    android:textAppearance="@style/TextAppearance.MotoWatermark.Label"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginBottom="4dp" />

                <!-- Row: Params | Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchParams"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_params"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_date"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="true" />
                </LinearLayout>

                <!-- Row: Logo | PNG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLogo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_logo"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPng"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_png"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="true" />
                </LinearLayout>

                <!-- Row: White Text | White BG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWhiteText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_white_text"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="false" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWhiteBg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/toggle_white_bg"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:checked="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Status overlay -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- v1.3.4: 设置入口（右上角，覆盖在整个界面上） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/settings_title"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_settings_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/md_theme_onSurface"
        style="@style/Widget.Material3.Button.TonalButton" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
